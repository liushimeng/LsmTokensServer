{
  "managerWebListenPort": 9101,
  "userWebListenPort": 29001,
  "mcpWebListenPort": 29002,
  "userWebUseHTTPS": true,
  "userWebCertFile": "server.crt",
  "userWebKeyFile": "server.key",
  "agentListenPort": 29000,
  "agentHttpsListenPort": 29003,
  "agentProductListenAddr": "0.0.0.0",
  "agentAnthropicListenURL": "Anthropic",
  "agentOpenAIListenURL": "OpenAI",
  "logFileURL": "LsmTokensServer.log",
  "logMaxSizeMB": 150,
  "DBMysql": {
    "Url": "127.0.0.1:3306",
    "DataBase": "lsmDB",
    "User": "<your-db-user>",
    "Pwd": "<your-db-password>",
    "Timeout": 5,
    "ShardingKey": "",
    "NumberOfShards": 0,
    "PrimaryKeyGenerator": 0
  },
  "tableMaxRows": 20000000,
  "DBMysqlSubTableNumber": 8,
  "buildDateTimeLogURL": "LsmTokensServerBuildDateTime.log",
  "userInfoLogURL": "LsmTokensServerUsersInfo.log",
  "enableSpiderScheduler": false,
  "spiderCDPPort": 9222,
  "spiderChromePath": "google-chrome-stable",
  "spiderChromeUserDataDir": "/tmp/lsm-spider-chrome",
  "spiderCDPHealthCheckSec": 30,
  "spiderCDPStartTimeoutSec": 30,
  "spiderHandlerTimeoutSec": 180,
  "spiderMaxConcurrency": 8,
  "spiderChromeCustomArgs": null,
  "spiderActionWaitSec": 60,
  "spiderRequestHeaders": {
    "Accept-Language": "zh-CN,zh;q=0.9,en;q=0.8"
  },
  "spiderAntiBotAutoRetry": 2,
  "spiderRSSFetchTimeoutSec": 15,
  "openClawURL": "http://127.0.0.1:18789/v1/chat/completions",
  "openClawAPIKey": "<your-openclaw-api-key>",
  "openClawModel": "openclaw",
  "openClawSystemPrompt": "user",
  "transactionRetentionDays": 15,
  "security": {
    "jwtSecret": "<your-random-jwt-secret-at-least-32-chars>",
    "managerUserName": "<your-manager-username>",
    "managerPassword": "<your-strong-manager-password>",
    "trustProxyHeaders": false
  }
}
